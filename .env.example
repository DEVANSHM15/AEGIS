# Embedding Configuration
# EMBEDDING_PROVIDER: 'local' (uses SentenceTransformers all-MiniLM-L6-v2 without API key) or 'openai'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# LLM Configuration
# LLM_PROVIDER: 'gemini', 'openai', 'ollama', 'mock'
# For Gemini: LLM_MODEL=gemini-3.6-flash
# For OpenAI: LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB & System Settings
VECTOR_DB_PATH=./data/chroma_db
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=15
